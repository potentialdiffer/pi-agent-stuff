# Dependencies
node_modules/
**/node_modules/

# Build outputs
*.js.map
dist/

# IDE/OS
.DS_Store
.idea/
.vscode/

# Environment and local config
.env
.env.*
*.local.json
!*.local.json.example

# Logs
*.log
logs/

# Files
*.pdf

# Extension specific
.pi-images/
client-ts/

# Local config (use config.example.json as template)
**/config.json
!**/config.example.json

# Lockfiles — extension-level locks ignored; the root package-lock.json is tracked.
# Extension runtime deps are declared in the ROOT package.json dependencies
# (authoritative; sub-manifest dependencies are documentation only — pi never installs them).
**/package-lock.json